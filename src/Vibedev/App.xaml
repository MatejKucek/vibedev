<Application x:Class="Vibedev.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vibedev">
    <Application.Resources>
        <SolidColorBrush x:Key="Surface" Color="#202024"/>
        <SolidColorBrush x:Key="Base" Color="#18181B"/>
        <SolidColorBrush x:Key="Line" Color="#34343A"/>
        <SolidColorBrush x:Key="Muted" Color="#9898A6"/>
        <SolidColorBrush x:Key="Accent" Color="#A78BFA"/>
        <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource Base}"/><Setter Property="Foreground" Value="#E4E4E7"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="UseLayoutRounding" Value="True"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E4E4E7"/></Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#24242A"/><Setter Property="Foreground" Value="#E4E4E7"/><Setter Property="BorderBrush" Value="#605272"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ProjectMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E4E4E7"/><Setter Property="Padding" Value="10,6"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{DynamicResource ProjectMenuItem}"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Style="{x:Null}" Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" MinWidth="150"/>
                                <Path x:Name="Arrow" Grid.Column="1" Data="M 0,0 L 4,4 L 0,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="4" VerticalOffset="-4" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="#24242A" BorderBrush="#605272" BorderThickness="1" CornerRadius="4" Padding="3">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Row" Property="Background" Value="#343044"/></Trigger>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#49405E"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#6B6B78"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="ProjectContextMenu" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="#E4E4E7"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="#24242A" BorderBrush="#605272" BorderThickness="1" CornerRadius="4" Padding="3">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/></ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="6,4" Background="#3C3C44"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ContextMenu" BasedOn="{StaticResource ProjectContextMenu}"/>
        <Style TargetType="MenuItem" BasedOn="{StaticResource ProjectMenuItem}"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#D4D4DC"/><Setter Property="Background" Value="#2A2A30"/><Setter Property="BorderBrush" Value="#3C3C44"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock"/></ContentPresenter.Resources></ContentPresenter></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#3B354B"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#8B70C8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="#222226"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#2E2E34"/><Setter TargetName="Label" Property="TextElement.Foreground" Value="#6B6B78"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#A78BFA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#E4E4E7"/><Setter Property="Background" Value="#18181B"/><Setter Property="BorderBrush" Value="#404049"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CaretBrush" Value="#A78BFA"/><Setter Property="Padding" Value="8,6"/><Setter Property="SelectionBrush" Value="#69518D"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"/>
                            <TextBlock x:Name="Placeholder" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="#9898A6" Margin="{TemplateBinding Padding}" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#A78BFA"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#E4E4E7"/><Setter Property="Background" Value="#24242A"/><Setter Property="BorderBrush" Value="#404049"/><Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Chrome">
                        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ButtonBorder" Background="#24242A" BorderBrush="#404049" BorderThickness="1" CornerRadius="4"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#A78BFA"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#A78BFA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,6,30,6" VerticalAlignment="Center" IsHitTestVisible="False" ClipToBounds="True"/>
                        <TextBlock x:Name="Placeholder" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="#9898A6" Margin="10,6,30,6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Visibility="Collapsed"/>
                        <Border x:Name="FocusBorder" BorderThickness="1" BorderBrush="#A78BFA" CornerRadius="4" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                            <Border Background="#24242A" BorderBrush="#605272" BorderThickness="1" CornerRadius="4" MinWidth="{Binding ActualWidth, ElementName=Chrome}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="3">
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedIndex" Value="-1"><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusBorder" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E4E4E7"/><Setter Property="Padding" Value="10,7"/><Setter Property="Background" Value="#24242A"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#343044"/></Trigger><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#49405E"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TreeView"><Setter Property="Background" Value="#1D1D21"/><Setter Property="Foreground" Value="#C4C4CE"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6"/></Style>
        <Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="#C4C4CE"/><Setter Property="Padding" Value="3,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
        <Style x:Key="ProjectTreeItem" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#C4C4CE"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border x:Name="Row" Grid.ColumnSpan="2" Background="Transparent" BorderThickness="2,0,0,0" BorderBrush="Transparent"/>
                        <ToggleButton x:Name="Expander" Width="16" Height="22" Focusable="False" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path x:Name="Chevron" Data="M 4,2 L 8,6 L 4,10" Stroke="#8C8C9C" StrokeThickness="1.3" Width="12" Height="12" RenderTransformOrigin="0.5,0.5"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chevron" Property="Stroke" Value="#DDD6FE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Header" Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="2,0,6,0"/>
                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
                        <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#28272F"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#343044"/><Setter TargetName="Row" Property="BorderBrush" Value="#A78BFA"/><Setter Property="Foreground" Value="#F0ECFA"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="TabControl"><Setter Property="Background" Value="#18181B"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/></Style>
        <Style TargetType="TabItem"><Setter Property="Foreground" Value="#9898A6"/><Setter Property="Background" Value="#202024"/><Setter Property="Padding" Value="14,10"/>
            <!-- The empty TextBlock style lets string headers follow the tab's foreground instead of the global TextBlock color, so unselected tabs read as dimmed. -->
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" BorderThickness="0,2,0,0" BorderBrush="Transparent" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"><ContentPresenter.Resources><Style TargetType="TextBlock"/></ContentPresenter.Resources></ContentPresenter></Border><ControlTemplate.Triggers>
                <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Tab" Property="Background" Value="#2A2A30"/><Setter Property="Foreground" Value="#D4D4DC"/></MultiTrigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#A78BFA"/><Setter TargetName="Tab" Property="Background" Value="#18181B"/><Setter Property="Foreground" Value="#F4F4F5"/></Trigger>
            </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#E4E4E7"/></Style>
        <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#D4D4DC"/><Setter Property="Padding" Value="10,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="#2A2A30"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#343044"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="#A78BFA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="GridSplitter"><Setter Property="Background" Value="#34343A"/><Setter Property="ShowsPreview" Value="True"/></Style>
        <Style TargetType="ScrollBar"><Setter Property="Background" Value="#202024"/><Setter Property="Width" Value="10"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#46464F" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Application.Resources>
</Application>
